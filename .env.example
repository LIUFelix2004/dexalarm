# OKX API credentials (optional - for real data)
# Get your keys from: https://web3.okx.com/onchain-os/dev-portal
OKX_API_KEY="your-api-key-here"
OKX_SECRET_KEY="your-secret-key-here"
OKX_PASSPHRASE="your-passphrase-here"

# Monitoring configuration
MIN_MARKET_CAP=10000000           # Minimum market cap in USD ($10M)
ALERT_VOLUME_SPIKE_PERCENT=30     # Volume spike threshold (30% increase in 30min)
ALERT_LARGE_TRADE_VALUE=10000     # Large trade threshold ($10,000 USD)
POLL_INTERVAL_MINUTES=10          # Data refresh interval

# Chains to monitor (comma separated, no spaces)
MONITOR_CHAINS=BSC,Base,SOL,ETH

# Server port
PORT=3000

# Notion integration (optional)
# NOTION_API_KEY="your-notion-api-key"
# NOTION_DATABASE_ID="your-database-id"